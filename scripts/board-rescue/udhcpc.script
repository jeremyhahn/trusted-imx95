#!/bin/sh
# udhcpc event script of the rescue initramfs: address and default route only.
# busybox udhcpc passes the event as $1 and the lease in the environment
# ($interface, $ip, $mask as a prefix length, $router).
# shellcheck disable=SC2154 # the lease variables come from udhcpc
case $1 in
bound | renew)
	ip addr flush dev "$interface"
	ip addr add "$ip/${mask:-24}" dev "$interface"
	for r in $router; do
		ip route add default via "$r" dev "$interface"
		break
	done
	;;
deconfig)
	ip addr flush dev "$interface"
	;;
esac
exit 0

[Unit]
Description=Mount the tee-data partition of the disk holding the root file system on /data
# No default dependencies, like the BSP's tee-supplicant@.service (Before=sysinit.target):
# the default ones would put this unit after sysinit.target and close an ordering cycle.
DefaultDependencies=no
Before=tee-nv-wipe.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/tee-data-mount
ExecStop=/bin/umount /data
# No [Install]: tee-nv-wipe.service requires this unit.

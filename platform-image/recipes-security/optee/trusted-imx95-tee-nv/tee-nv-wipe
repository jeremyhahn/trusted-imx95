#!/bin/sh
# Couple the fTPM NV to every write of the root partition (SPEC row ftpm: the
# REE-FS NV is wiped with the root file system). The content id of the image
# (/etc/trusted-imx95-rootfs-id) cannot tell a rewrite of the very same image
# apart, so it is only an extra condition. The binding is a random token kept
# in two places: in the first 512-byte sector of the root partition, and in
# /data/tee-root-token beside the NV. Every boot compares them. A missing,
# zeroed, malformed or unequal token, or a different content id, wipes
# /data/tee, writes a fresh token to both places and records the content id.
#
# Why that sector: it is the boot-sector padding in front of the ext4 superblock
# (bytes 0-1023), which ext4 does not use. The image holds a NONZERO "unbound"
# marker there (files/root-marker.sh: no zero byte, so no sparse writer can skip
# the sector). It is part of the file-system image itself, so any write of that
# image, whether the whole partition or only the file-system bytes, sparse or
# not, replaces the token with the marker, and the next boot finds no valid token:
# the marker, zeros or any value that is not this device's saved token is a fresh root. For that, block 0 must always be written by an
# image copy, so the block size must be 4096 or more (the superblock then shares
# block 0 with the padding; with 1 KiB blocks block 0 is all zeros and a sparse
# copy may skip it): a smaller block size fails closed. The file system's end is
# not looked at, so the layout needs no reserved space.
#
# It fails closed: a sector that cannot be read, or a root that does not show an
# ext4 superblock with a block size of 4096 or more, wipes the NV and exits
# non-zero; a sector or record that cannot be written exits non-zero (after the
# wipe, so no old NV is left); tee-supplicant, which requires this unit, then
# does not start. A saved record that exists but cannot be read also stops the
# unit and touches nothing, as do a read-only /data and a rebind whose root
# device is read-only (both checked before the wipe).
#
# TEE_NV_DATA, TEE_NV_ROOTFS_ID, TEE_NV_ROOTDEV (the root partition's device),
# TEE_NV_MOUNTINFO, TEE_NV_SYS, TEE_NV_DEV and TEE_NV_RANDOM exist for the test
# (test/platform_image_ftpm_test.sh).
set -eu

data=${TEE_NV_DATA:-/data}
idfile=${TEE_NV_ROOTFS_ID:-/etc/trusted-imx95-rootfs-id}
mountinfo=${TEE_NV_MOUNTINFO:-/proc/self/mountinfo}
sys=${TEE_NV_SYS:-/sys}
dev=${TEE_NV_DEV:-/dev}
rnd=${TEE_NV_RANDOM:-/dev/urandom}
rootdev=${TEE_NV_ROOTDEV:-}
magic=TEEBIND1

die() { echo "tee-nv-wipe: $*" >&2; exit 1; }

cur=$(cat "$idfile") || die "cannot read $idfile"
[ -n "$cur" ] || die "$idfile is empty"
[ -d "$data" ] || die "$data is not a directory"
# No temporary file outlives the run, whatever stops it.
trap 'rm -f "$data/.root-token.read" "$data/.root-token.check" "$data/.tee-root-token.new" "$data/.tee-rootfs-id.new" "$data/.tee-nv-wipe.probe"' EXIT
# /data must take a file: the token sector is read through it, and a rebind
# writes the records there. A read-only /data stops here and touches nothing
# (it would otherwise fail the read and wipe what it can of the NV).
probe=$data/.tee-nv-wipe.probe
true >"$probe" || die "$data is read-only or full: the token cannot be checked nor the records written; leaving $data/tee alone"
rm -f "$probe"

# The device that holds /, from the major:minor of the last mount on / and sysfs.
if [ -z "$rootdev" ]; then
	majmin=
	while read -r _id _parent mm _root mp _rest; do
		[ "$mp" = / ] && majmin=$mm
	done <"$mountinfo"
	case $majmin in '' | *[!0-9:]* | : | :* | *:) die "no usable device number for / in $mountinfo" ;; esac
	name=
	while IFS= read -r l; do
		case $l in DEVNAME=*) name=${l#DEVNAME=} ;; esac
	done <"$sys/dev/block/$majmin/uevent" || die "cannot read the uevent of $majmin"
	case $name in '' | */* | .*) die "bad device name for $majmin" ;; esac
	rootdev=$dev/$name
fi

wipe() {
	rm -rf "$data/tee" "$data/tee-root-token" "$data/tee-rootfs-id"
	mkdir -p "$data/tee"
	chmod 0700 "$data/tee"
	sync
}

# Read the first LEN bytes at OFFSET of $rootdev as hex bytes (one string).
hexat() { od -An -v -tx1 -j "$1" -N "$2" "$rootdev" | tr -d ' \n'; }

# Read the token sector. Any failure here is a fail-closed wipe: the NV cannot be
# shown to belong to this root.
rtok=
ok=1
if [ "$(hexat 1080 2 2>/dev/null)" != 53ef ]; then
	ok=0 # no ext4 superblock magic
else
	lbs=$(od -An -v -tu1 -j 1048 -N 4 "$rootdev" 2>/dev/null) || lbs=
	# s_log_block_size, little endian: block size is 1024 << value; 4096 is 2.
	# shellcheck disable=SC2086 # four small integers, split on purpose
	set -- $lbs
	if [ "$#" -ne 4 ] || [ "$2" -ne 0 ] || [ "$3" -ne 0 ] || [ "$4" -ne 0 ] || [ "$1" -lt 2 ] || [ "$1" -gt 6 ]; then
		ok=0
	else
		tmp=$data/.root-token.read
		if dd if="$rootdev" of="$tmp" bs=512 skip=0 count=1 2>/dev/null; then
			rtok=$(tr -d '\000' <"$tmp") || ok=0
		else
			ok=0
		fi
		rm -f "$tmp"
	fi
fi
if [ "$ok" = 0 ]; then
	echo "tee-nv-wipe: the token sector of $rootdev cannot be read or the root shows no ext4 block size of 4096 or more: wiping $data/tee, failing closed" >&2
	wipe
	exit 1
fi

# The saved records are read in their own checked assignments, outside any
# condition. Absent: the NV is of unknown origin, wipe. Present but unreadable
# (a directory, no permission, an I/O error): its content is unknown, so exit
# non-zero and touch nothing; an I/O error must not destroy the NV.
saved=
stok=
for f in tee-rootfs-id tee-root-token; do
	v=
	if [ -e "$data/$f" ] || [ -L "$data/$f" ]; then
		v=$(cat "$data/$f") || die "$data/$f exists but cannot be read; leaving $data/tee alone"
	fi
	case $f in tee-rootfs-id) saved=$v ;; *) stok=$v ;; esac
done

# A valid token is "TEEBIND1 " and 64 lowercase hex characters.
valid=0
case $rtok in
"$magic "*)
	t=${rtok#"$magic "}
	case $t in *[!0-9a-f]*) ;; *) [ "${#t}" -eq 64 ] && valid=1 ;; esac
	;;
esac
if [ "$valid" = 1 ] && [ "$rtok" = "$stok" ] && [ "$saved" = "$cur" ]; then
	exit 0
fi

# A rebind writes the root device, so it is checked before anything is touched
# (/data was checked at the start). The image mounts / read-only, and the root
# device may refuse writes (its sysfs ro flag set, a write-protected medium, a
# kernel that will not open a mounted device for writing). Wiping first would leave
# a wiped NV and no token, and every later boot would wipe again; a read-only
# target therefore exits non-zero and changes nothing. tee-supplicant then does
# not start, so the old NV stays unused, and the first boot with writable
# targets rebinds. A bound root needs no write and boots on a read-only device.
rofile=$sys/class/block/${rootdev##*/}/ro
if [ -e "$rofile" ]; then
	rof=$(cat "$rofile") || die "cannot read $rofile; leaving $data/tee alone"
	[ "$rof" = 0 ] || die "$rootdev is read-only ($rofile is $rof): the root token cannot be written; leaving $data/tee alone"
fi
true 1<>"$rootdev" ||
	die "$rootdev cannot be opened for writing (a read-only medium, or the kernel refuses writes to a mounted device): the root token cannot be written; leaving $data/tee alone"

echo "tee-nv-wipe: root token or rootfs identity changed, missing or unequal: wiping $data/tee" >&2
wipe

new=$(head -c 32 "$rnd" | od -An -v -tx1 | tr -d ' \n') || die "cannot read random bytes from $rnd"
[ "${#new}" -eq 64 ] || die "short random read from $rnd"
tok="$magic $new"
# The sector first, read back; the data side last, through a temporary file and
# a rename, so a power cut in between leaves no record and the next boot wipes again.
printf '%s\n' "$tok" | dd of="$rootdev" bs=512 seek=0 count=1 conv=notrunc,sync 2>/dev/null ||
	die "cannot write the token sector of $rootdev"
sync
tmp=$data/.root-token.check
dd if="$rootdev" of="$tmp" bs=512 skip=0 count=1 2>/dev/null || die "cannot read back the token sector"
back=$(tr -d '\000' <"$tmp") || die "cannot read back the token sector"
rm -f "$tmp"
[ "$back" = "$tok" ] || die "the token sector of $rootdev did not keep the token"

tmp=$data/.tee-root-token.new
printf '%s\n' "$tok" >"$tmp" || die "cannot write $tmp"
sync
mv -f "$tmp" "$data/tee-root-token" || die "cannot rename $tmp to $data/tee-root-token"
tmp=$data/.tee-rootfs-id.new
printf '%s\n' "$cur" >"$tmp" || die "cannot write $tmp"
sync
mv -f "$tmp" "$data/tee-rootfs-id" || die "cannot rename $tmp to $data/tee-rootfs-id"
sync
